{
  "name": "userscripts-cf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "sync:rod-runtime": "node build/sync-rod-runtime.mjs",
    "build:b": "node labs/remote-release/build-worker.mjs B",
    "test": "npm run typecheck && npm run build && vitest run tests/class-references.test.js tests/css-modules-integration.test.js tests/css-deduplicate.test.js tests/package-icons.test.js tests/runtime.test.js tests/runtime-helpers.test.js tests/runtime-dom-http.test.js tests/runtime-gm-storage.test.js tests/config-assets.test.js tests/styles.test.js tests/readable-strings.test.js tests/hosting.test.js tests/release.test.js tests/publish-github.test.js && npm run test:lab",
    "format": "prettier --write .",
    "build:lab": "node labs/remote-release/build-worker.mjs A",
    "build:lab:b": "node labs/remote-release/build-worker.mjs B",
    "test:lab": "npm run build:lab && node labs/remote-release/test.mjs",
    "format:check": "prettier --check .",
    "new": "node build/new.mjs",
    "release": "node build/release.mjs",
    "build:hosting": "npm run build && node build/hosting.mjs",
    "ci:cloudflare:old": "npm run format:check && npm run lint && npm test && node build/hosting.mjs",
    "ci:cloudflare": "npm run build:hosting",
    "deploy:cloudflare": "node build/deploy-cloudflare.mjs",
    "publish:github": "node build/publish-github.mjs",
    "typecheck": "tsc -p tsconfig.repl.json && tsc -p tsconfig.rodx.json && tsc -p tsconfig.instagram.json && tsc -p tsconfig.integrations.json",
    "lint": "node build/check-style.mjs",
    "lint:fix": "node build/check-style.mjs --fix"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.32",
    "postcss-nesting": "^14.0.3",
    "prettier": "3.9.10",
    "svgo": "^4.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "@solidjs/compiler": "2.0.0-rc.21",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@solidjs/web": "2.0.0-rc.21",
    "acorn": "8.19.0",
    "astring": "1.9.0",
    "eslint-scope": "9.1.2",
    "nanoid": "^6.0.0",
    "solid-js": "2.0.0-rc.21"
  },
  "version": "4.0.1"
}
