{
  "name": "userscripts-cf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "build:b": "node labs/remote-release/build-worker.mjs B",
    "test": "npm run build && node --test tests/*.test.js && npm run test:lab",
    "format": "prettier --write .",
    "build:lab": "node labs/remote-release/build-worker.mjs A",
    "build:lab:b": "node labs/remote-release/build-worker.mjs B",
    "test:lab": "npm run build:lab && node labs/remote-release/test.mjs",
    "format:check": "prettier --check .",
    "new": "node build/new.mjs",
    "release": "node build/release.mjs",
    "build:hosting": "npm run build && node build/hosting.mjs",
    "ci:cloudflare": "npm run format:check && npm test && node build/hosting.mjs",
    "deploy:cloudflare": "node build/deploy-cloudflare.mjs",
    "publish:github": "node build/publish-github.mjs"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "vite": "8.3.8"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "astring": "1.9.0",
    "eslint-scope": "9.1.2",
    "nanoid": "^5.1.6"
  },
  "version": "3.10.3"
}
