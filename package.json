{
  "name": "userscripts-cf",
  "author": "rodkisten",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "check:react-roots": "node build/check-react-root-ownership.mjs",
    "sync:rod-runtime": "node build/sync-rod-runtime.mjs",
    "build:b": "node labs/remote-release/build-worker.mjs B",
    "test:perf": "vitest run tests/runtime-startup-benchmark.test.js",
    "test": "npm run typecheck && npm run build && npm run test:unit && npm run test:lab",
    "format": "prettier --write .",
    "build:lab": "node labs/remote-release/build-worker.mjs A",
    "build:lab:b": "node labs/remote-release/build-worker.mjs B",
    "test:lab": "npm run build:lab && node labs/remote-release/test.mjs",
    "format:check": "prettier --check .",
    "new": "node build/new.mjs",
    "release": "node build/release.mjs",
    "build:hosting": "npm run build && node build/hosting.mjs",
    "ci:cloudflare:old": "npm run format:check && npm run lint && npm test && node build/hosting.mjs",
    "ci:cloudflare": "npm run build:hosting",
    "deploy:cloudflare": "node build/deploy-cloudflare.mjs",
    "publish:github": "node build/publish-github.mjs",
    "typecheck": "npm run check:react-only && tsc --noEmit -p tsconfig.json",
    "lint": "node build/check-style.mjs",
    "lint:fix": "node build/check-style.mjs --fix",
    "check:design-system": "node build/check-design-system-changes.mjs",
    "test:design-system": "npm run typecheck:react",
    "typecheck:react": "tsc --noEmit -p tsconfig.react.json",
    "test:unit": "node build/run-runtime-utility-tests.mjs",
    "check:react-only": "node build/check-react-only.mjs",
    "check:react-syntax": "node build/check-react-syntax.mjs",
    "check:react-syntax:fix": "node build/check-react-syntax.mjs --fix"
  },
