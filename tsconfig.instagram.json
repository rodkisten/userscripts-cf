{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": [
    "src/userscripts/instagram-saved/**/*.ts",
    "src/userscripts/instagram-saved/**/*.tsx",
    "src/types/styles.d.ts"
  ]
}
