{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": []
  },
  "include": ["src/userscripts/**/*.ts", "src/userscripts/**/*.tsx", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
